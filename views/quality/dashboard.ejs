<% layout('layouts/boilerplate') %>
<section class="quality-hero"><div class="container"><div class="overline light"><span></span><%= lang === 'en' ? 'TRANSPARENCY BY DESIGN' : '数据透明度' %></div><h1><%= lang === 'en' ? 'What do we actually know?' : '我们究竟知道多少？' %></h1><p><%= lang === 'en' ? 'A live view of coverage, evidence quality and unresolved uncertainty across Camping Recommend System.' : '实时展示 Camping Recommend System 的覆盖范围、证据质量与仍未解决的不确定性。' %></p></div></section>
<section class="container quality-content">
  <div class="quality-metrics"><div><span><%= lang === 'en' ? 'Published campsites' : '已发布营地' %></span><strong><%= (summary.total || 0).toLocaleString() %></strong></div><div><span><%= lang === 'en' ? 'Average trust score' : '平均可信度' %></span><strong><%= Math.round(summary.avgReliability || 0) %><small>/100</small></strong></div><div><span><%= lang === 'en' ? 'Listings with phone' : '有联系电话' %></span><strong><%= summary.total ? Math.round(summary.withPhone / summary.total * 100) : 0 %><small>%</small></strong></div><div><span><%= lang === 'en' ? 'Confirmed amenities' : '确认设施覆盖' %></span><strong><%= summary.total ? Math.round(summary.withAmenities / summary.total * 100) : 0 %><small>%</small></strong></div><div><span><%= lang === 'en' ? 'Text-inferred amenities' : '文本推断覆盖' %></span><strong><%= summary.total ? Math.round(summary.withInferredAmenities / summary.total * 100) : 0 %><small>%</small></strong></div></div>
  <div class="quality-grid"><section><h2><%= lang === 'en' ? 'Reliability distribution' : '可信度分布' %></h2><div class="bar-list"><% levels.forEach(item => { %><div><span><%= item._id || 'low' %></span><div><i style="width:<%= summary.total ? item.count / summary.total * 100 : 0 %>%"></i></div><strong><%= item.count %></strong></div><% }) %></div></section><section><h2><%= lang === 'en' ? 'Data sources' : '数据来源' %></h2><div class="bar-list"><% sources.forEach(item => { %><div><span><%= item._id %></span><div><i style="width:<%= summary.total ? item.count / summary.total * 100 : 0 %>%"></i></div><strong><%= item.count %></strong></div><% }) %></div></section></div>
  <% const reasonLabels = lang === 'en' ? { low_trust: 'Low evidence confidence', stale_information: 'Stale information', missing_critical_fields: 'Missing critical fields', conflicting_reports: 'Conflicting reports', unknown_operational_status: 'Unknown operating status' } : { low_trust: '证据可信度偏低', stale_information: '信息较陈旧', missing_critical_fields: '关键字段缺失', conflicting_reports: '存在冲突报告', unknown_operational_status: '营业状态未知' }; %>
  <section class="quality-table verification-plan">
    <div class="results-header">
      <div><div class="overline"><span></span><%= lang === 'en' ? 'ACTIVE VERIFICATION' : '主动数据核验' %></div><h2><%= lang === 'en' ? 'Where should verification start?' : '有限人力应该先核验哪里？' %></h2></div>
      <p><%= lang === 'en' ? 'A greedy coverage algorithm balances information risk with geographic and failure-mode diversity.' : '贪心覆盖算法同时考虑信息风险、地区覆盖和问题类型，避免核验任务集中在少数城市。' %></p>
    </div>
    <div class="plan-summary">
      <div><strong><%= planSummary.count %></strong><span><%= lang === 'en' ? 'verification slots' : '核验名额' %></span></div>
      <div><strong><%= planSummary.provinceCoverage %></strong><span><%= lang === 'en' ? 'provinces covered' : '覆盖省份' %></span></div>
      <div><strong><%= planSummary.cityCoverage %></strong><span><%= lang === 'en' ? 'cities covered' : '覆盖城市' %></span></div>
      <div><strong><%= planSummary.averageRisk %></strong><span><%= lang === 'en' ? 'average risk' : '平均信息风险' %></span></div>
    </div>
    <div class="algorithm-note"><code>verify-plan-v1</code><span><%= lang === 'en' ? 'Priority = verification risk + diminishing-return coverage bonus. Every selection remains explainable.' : '优先级 = 核验风险 + 边际递减的覆盖奖励；每一次选择都有明确原因。' %></span><a href="/api/v1/verification-plan?limit=20"><%= lang === 'en' ? 'View JSON API' : '查看 JSON API' %></a></div>
    <div class="table-responsive"><table><thead><tr><th>#</th><th><%= lang === 'en' ? 'Campsite' : '营地' %></th><th><%= lang === 'en' ? 'Location' : '地区' %></th><th><%= lang === 'en' ? 'Why verify' : '优先核验原因' %></th><th><%= lang === 'en' ? 'Trust' : '可信度' %></th><th><%= lang === 'en' ? 'Priority' : '优先分' %></th></tr></thead><tbody><% verificationPlan.forEach(item => { %><tr><td><strong><%= item.rank %></strong></td><td><a href="/campgrounds/<%= item.campground._id %>"><%= item.campground.title %></a><small><%= item.campground.dataSource %></small></td><td><%= item.campground.province %> · <%= item.campground.city %></td><td><div class="verification-reasons"><% item.verification.reasons.slice(0, 2).forEach(reason => { %><span><%= reasonLabels[reason.code] || reason.code %></span><% }) %></div></td><td><span class="trust-chip trust-<%= item.campground.reliability?.level || 'low' %>"><%= item.campground.reliability?.score || 0 %></span></td><td><strong class="priority-score"><%= item.marginalScore %></strong></td></tr><% }) %></tbody></table></div>
  </section>
</section>
