<% layout('layouts/boilerplate') %>
<section class="quality-hero"><div class="container"><div class="overline light"><span></span><%= lang === 'en' ? 'TRANSPARENCY BY DESIGN' : '数据透明度' %></div><h1><%= lang === 'en' ? 'What do we actually know?' : '我们究竟知道多少？' %></h1><p><%= lang === 'en' ? 'A live view of coverage, evidence quality and unresolved uncertainty across CampFinder.' : '实时展示 CampFinder 的覆盖范围、证据质量与仍未解决的不确定性。' %></p></div></section>
<section class="container quality-content">
  <div class="quality-metrics"><div><span><%= lang === 'en' ? 'Published campsites' : '已发布营地' %></span><strong><%= (summary.total || 0).toLocaleString() %></strong></div><div><span><%= lang === 'en' ? 'Average trust score' : '平均可信度' %></span><strong><%= Math.round(summary.avgReliability || 0) %><small>/100</small></strong></div><div><span><%= lang === 'en' ? 'Listings with phone' : '有联系电话' %></span><strong><%= summary.total ? Math.round(summary.withPhone / summary.total * 100) : 0 %><small>%</small></strong></div><div><span><%= lang === 'en' ? 'Confirmed amenities' : '确认设施覆盖' %></span><strong><%= summary.total ? Math.round(summary.withAmenities / summary.total * 100) : 0 %><small>%</small></strong></div><div><span><%= lang === 'en' ? 'Text-inferred amenities' : '文本推断覆盖' %></span><strong><%= summary.total ? Math.round(summary.withInferredAmenities / summary.total * 100) : 0 %><small>%</small></strong></div></div>
  <div class="quality-grid"><section><h2><%= lang === 'en' ? 'Reliability distribution' : '可信度分布' %></h2><div class="bar-list"><% levels.forEach(item => { %><div><span><%= item._id || 'low' %></span><div><i style="width:<%= summary.total ? item.count / summary.total * 100 : 0 %>%"></i></div><strong><%= item.count %></strong></div><% }) %></div></section><section><h2><%= lang === 'en' ? 'Data sources' : '数据来源' %></h2><div class="bar-list"><% sources.forEach(item => { %><div><span><%= item._id %></span><div><i style="width:<%= summary.total ? item.count / summary.total * 100 : 0 %>%"></i></div><strong><%= item.count %></strong></div><% }) %></div></section></div>
  <section class="quality-table"><div class="results-header"><h2><%= lang === 'en' ? 'Lowest-confidence records' : '最需要补充证据的营地' %></h2><p><%= lang === 'en' ? 'These records are prioritized for community verification.' : '这些记录会优先邀请社区进行现场确认。' %></p></div><div class="table-responsive"><table><thead><tr><th><%= lang === 'en' ? 'Campsite' : '营地' %></th><th><%= lang === 'en' ? 'City' : '城市' %></th><th><%= lang === 'en' ? 'Source' : '来源' %></th><th><%= lang === 'en' ? 'Trust' : '可信度' %></th><th><%= lang === 'en' ? 'Open issues' : '未解决报告' %></th></tr></thead><tbody><% stale.forEach(item => { %><tr><td><a href="/campgrounds/<%= item._id %>"><%= item.title %></a></td><td><%= item.city %></td><td><%= item.dataSource %></td><td><span class="trust-chip trust-<%= item.reliability?.level || 'low' %>"><%= item.reliability?.score || 0 %></span></td><td><%= item.reliability?.openIssueCount || 0 %></td></tr><% }) %></tbody></table></div></section>
</section>
