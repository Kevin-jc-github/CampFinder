<% layout('layouts/boilerplate') %>
<section class="recommend-hero"><div class="container narrow-container"><div class="overline light"><span></span><%= lang === 'en' ? 'EXPLAINABLE RECOMMENDATIONS' : '可解释推荐系统' %></div><h1><%= lang === 'en' ? 'Find a campsite that fits your trip.' : '找到真正适合这次出发的营地。' %></h1><p><%= lang === 'en' ? 'Recommendations combine distance, budget, amenities, camp style, data reliability and rating. Every result explains why it was selected.' : '系统综合距离、预算、设施、营地类型、数据可信度与评分，并解释每一个推荐结果。' %></p></div></section>
<section class="container recommend-content"><form action="/recommendations" method="POST" class="recommend-form"><div class="recommend-grid"><label class="wide"><span><%= lang === 'en' ? 'Starting point' : '出发地点' %></span><input name="origin" value="<%= preferences.originLabel || '' %>" placeholder="<%= lang === 'en' ? 'e.g. Shanghai Jing’an' : '例如：上海市静安区' %>" required></label><label><span><%= lang === 'en' ? 'Maximum distance' : '最大范围' %></span><select name="radiusKm"><% [50,100,200,300,500,1000].forEach(value => { %><option value="<%= value %>" <%= Number(preferences.radiusKm) === value ? 'selected' : '' %>><%= value %> km</option><% }) %></select></label><label><span><%= lang === 'en' ? 'Budget per night' : '每晚预算' %></span><input type="number" min="0" name="maxPrice" value="<%= preferences.maxPrice || '' %>" placeholder="¥"></label></div><div class="preference-group"><span><%= lang === 'en' ? 'Preferred styles' : '偏好类型' %></span><div class="choice-pills"><% ['山野营地','湖畔营地','海边营地','森林营地','草原营地','房车营地','亲子营地','精致露营'].forEach(item => { %><label><input type="checkbox" name="types[]" value="<%= item %>" <%= preferences.types?.includes(item) ? 'checked' : '' %>><span><%= tv(item) %></span></label><% }) %></div></div><div class="preference-group"><span><%= lang === 'en' ? 'Must-have amenities' : '必备设施' %></span><div class="choice-pills"><% ['卫生间','淋浴','水电桩','停车场','可明火','可带宠物','儿童活动','装备租赁','餐饮','手机信号'].forEach(item => { %><label><input type="checkbox" name="amenities[]" value="<%= item %>" <%= preferences.amenities?.includes(item) ? 'checked' : '' %>><span><%= tv(item) %></span></label><% }) %></div></div><button class="primary-action"><%= lang === 'en' ? 'Generate recommendations' : '生成推荐' %> →</button></form>
<% if (results) { %><div class="recommend-results"><div class="results-header"><h2><%= lang === 'en' ? 'Your ranked matches' : '为你排序的结果' %></h2><p><%= results.length %> <%= lang === 'en' ? 'candidates evaluated with recommend-v1' : '个候选结果 · recommend-v1' %></p></div><% if (!results.length) { %><div class="empty-state"><h2><%= lang === 'en' ? 'No campsites found in this radius.' : '这个范围内暂未找到营地。' %></h2></div><% } %><div class="recommend-list"><% results.forEach(({ campground, recommendation }, index) => { const cover = campground.images?.[0]?.url || '/images/camp-placeholder.svg'; %><article class="recommend-card"><div class="rank-number"><%= String(index + 1).padStart(2,'0') %></div><img src="<%= cover %>" onerror="this.onerror=null;this.src='/images/camp-placeholder.svg'" alt=""><div class="recommend-body"><div class="camp-meta"><span class="camp-type"><%= tv(campground.type) %></span><span class="trust-chip trust-<%= campground.reliability?.level || 'low' %>"><%= lang === 'en' ? 'Trust' : '可信度' %> <%= campground.reliability?.score || 0 %></span></div><h3><a href="/campgrounds/<%= campground._id %>"><%= campground.title %></a></h3><p><%= campground.city %> · <%= recommendation.distanceKm != null ? `${Math.round(recommendation.distanceKm)} km` : (lang === 'en' ? 'distance unavailable' : '距离未知') %></p><div class="reason-list"><% recommendation.explanations.forEach(reason => { %><span><% if (reason.code === 'nearby') { %>✓ <%= lang === 'en' ? `${reason.value} km from your start` : `距离出发地约 ${reason.value} 公里` %><% } else if (reason.code === 'within_budget') { %>✓ <%= lang === 'en' ? 'Within your budget' : '符合预算' %><% } else if (reason.code === 'amenity_match') { %>✓ <%= reason.value.map(tv).join(' · ') %><% } else if (reason.code === 'type_match') { %>✓ <%= tv(reason.value) %><% } else if (reason.code === 'high_reliability') { %>✓ <%= lang === 'en' ? 'Strong supporting evidence' : '数据证据较充分' %><% } else if (reason.code === 'high_rating') { %>✓ <%= lang === 'en' ? `Rated ${reason.value}` : `评分 ${reason.value}` %><% } %></span><% }) %></div><p class="recommend-narrative"><strong><%= lang === 'en' ? 'Why this result:' : '为什么推荐：' %></strong> <%= recommendation.narrative?.[lang] %></p></div><div class="recommend-score"><strong><%= recommendation.score %></strong><span><%= lang === 'en' ? 'match' : '匹配度' %></span><a href="/campgrounds/<%= campground._id %>">→</a></div></article><% }) %></div></div><% } %></section>
