<% layout('layouts/boilerplate') %><section class="auth-page-new"><div class="auth-visual register-visual"><div class="auth-mountain"><span class="auth-moon"></span><span class="auth-tent"></span></div><div><span class="overline light">CAMPFINDER</span><h2><%= lang === 'en' ? 'Share places worth the journey.' : '分享那些，值得出发的地方。' %></h2></div></div><div class="auth-panel"><div class="auth-card-new"><span class="overline dark"><%= t('auth.join') %></span><h1><%= t('auth.registerTitle') %></h1><form action="/register" method="POST" class="validated-form" novalidate><label><span><%= t('auth.username') %></span><input name="username" minlength="3" maxlength="30" required autofocus autocomplete="username"></label><label><span><%= t('auth.email') %></span><input type="email" name="email" required autocomplete="email"></label><label><span><%= t('auth.password') %></span><input type="password" name="password" minlength="8" required autocomplete="new-password"></label><button><%= t('auth.register') %> →</button></form><p><%= t('auth.hasAccount') %> <a href="/login"><%= t('auth.loginNow') %></a></p></div></div></section>
