<% const selectedAmenities = campground?.amenities || []; %>
<div class="form-section"><span class="form-section-number">01</span><div class="form-section-body"><h2><%= lang === 'en' ? 'Basic information' : '基本信息' %></h2><div class="form-grid"><label class="wide"><span><%= t('form.name') %> *</span><input name="campground[title]" value="<%= campground?.title || '' %>" required maxlength="80"></label><label><span><%= t('form.type') %> *</span><select name="campground[type]" required><% ['山野营地','湖畔营地','海边营地','森林营地','草原营地','房车营地','亲子营地','精致露营'].forEach(item => { %><option value="<%= item %>" <%= campground?.type === item ? 'selected' : '' %>><%= tv(item) %></option><% }) %></select></label><label><span><%= t('form.province') %> *</span><input name="campground[province]" value="<%= campground?.province || '' %>" placeholder="<%= lang === 'en' ? 'e.g. Zhejiang' : '例如：浙江省' %>" required></label><label><span><%= t('form.city') %> *</span><input name="campground[city]" value="<%= campground?.city || '' %>" placeholder="<%= lang === 'en' ? 'e.g. Hangzhou' : '例如：杭州市' %>" required></label><label><span><%= t('form.district') %></span><input name="campground[district]" value="<%= campground?.district || '' %>"></label><label class="full"><span><%= t('form.address') %> *</span><input name="campground[location]" value="<%= campground?.location || '' %>" placeholder="<%= t('form.addressHint') %>" required></label></div></div></div>
<div class="form-section"><span class="form-section-number">02</span><div class="form-section-body"><h2><%= lang === 'en' ? 'Stay details' : '入住信息' %></h2><div class="form-grid thirds"><label><span><%= t('form.price') %> *</span><div class="input-prefix"><b>¥</b><input type="number" min="0" name="campground[price]" value="<%= campground?.price ?? '' %>" required></div></label><label><span><%= t('form.priceUnit') %> *</span><select name="campground[priceUnit]"><% ['帐篷/晚','人/晚','车位/晚','整租/晚'].forEach(item => { %><option value="<%= item %>" <%= campground?.priceUnit === item ? 'selected' : '' %>><%= tv(item) %></option><% }) %></select></label><label><span><%= t('form.capacity') %> *</span><input type="number" min="1" max="5000" name="campground[capacity]" value="<%= campground?.capacity || 20 %>" required></label><label class="full"><span><%= t('form.description') %> *</span><textarea rows="6" maxlength="3000" name="campground[description]" required><%= campground?.description || '' %></textarea></label></div></div></div>
<div class="form-section"><span class="form-section-number">03</span><div class="form-section-body"><h2><%= t('form.facilities') %></h2><div class="amenities-grid"><% ['卫生间','淋浴','水电桩','停车场','可明火','可带宠物','儿童活动','装备租赁','餐饮','手机信号'].forEach(item => { %><label class="amenity-check"><input type="checkbox" name="campground[amenities][]" value="<%= item %>" <%= selectedAmenities.includes(item) ? 'checked' : '' %>><span>✓</span><%= tv(item) %></label><% }) %></div></div></div>
<div class="form-section"><span class="form-section-number">04</span><div class="form-section-body"><h2><%= lang === 'en' ? 'Contact & media' : '联系与图片' %></h2><div class="form-grid thirds"><label><span><%= t('form.season') %></span><input name="campground[openSeason]" value="<%= campground?.openSeason || '全年' %>"></label><label><span><%= t('form.phone') %></span><input name="campground[contactPhone]" value="<%= campground?.contactPhone || '' %>"></label><label><span><%= t('form.wechat') %></span><input name="campground[wechat]" value="<%= campground?.wechat || '' %>"></label><label class="wide"><span><%= t('form.bookingUrl') %></span><input type="url" name="campground[bookingUrl]" value="<%= campground?.bookingUrl || '' %>" placeholder="https://"></label><label><span><%= t('form.imageUrl') %></span><input type="url" name="campground[imageUrl]" placeholder="https://"></label><label class="full upload-field"><span><%= t('form.upload') %></span><input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple></label><label><span><%= t('form.longitude') %></span><input type="number" step="any" min="73" max="136" name="campground[longitude]" value="<%= campground?.geometry?.coordinates?.[0] || '' %>"></label><label><span><%= t('form.latitude') %></span><input type="number" step="any" min="3" max="54" name="campground[latitude]" value="<%= campground?.geometry?.coordinates?.[1] || '' %>"></label></div></div></div>
