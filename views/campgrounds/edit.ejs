<% layout('layouts/boilerplate') %><section class="form-page-new"><div class="container narrow-container"><div class="form-heading"><h1><%= t('form.editTitle') %></h1></div><form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="editor-form validated-form" novalidate><%- include('_form', { campground }) %><% if (campground.images.some(image => image.filename)) { %><div class="form-section"><span class="form-section-number">05</span><div class="form-section-body"><h2><%= t('form.deleteImages') %></h2><div class="image-edit-grid"><% campground.images.forEach(image => { if (image.filename) { %><label><img src="<%= image.url %>" alt=""><span><input type="checkbox" name="deleteImages[]" value="<%= image.filename %>"> <%= t('form.deleteImage') %></span></label><% } }) %></div></div></div><% } %><div class="form-actions"><button class="primary-action"><%= t('form.save') %> →</button><a href="/campgrounds/<%= campground._id %>"><%= t('form.cancel') %></a></div></form></div></section>
