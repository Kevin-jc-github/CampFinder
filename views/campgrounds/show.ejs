<% layout('layouts/boilerplate') %>
<% const average = campground.reviews.length ? (campground.reviews.reduce((sum, review) => sum + review.rating, 0) / campground.reviews.length).toFixed(1) : null; %>
<% const detailDescription = lang === 'en' && campground.dataSource === 'amap' ? `${campground.title} is listed by Amap as a campsite in ${campground.province}, ${campground.city}. Opening hours, rates, overnight rules and amenities may change. Contact the operator before travelling.` : campground.description; %>
<section class="detail-hero"><div class="container"><a class="back-link" href="/campgrounds">← <%= t('nav.explore') %></a><div class="detail-title-row"><div><div class="camp-meta"><span class="camp-type"><%= tv(campground.type) %></span><% if (campground.dataSource === 'amap') { %><span class="source-label"><%= t('detail.amapSource') %></span><% } else if (campground.verified) { %><span class="verified">✓ <%= t('card.verified') %></span><% } %></div><h1><%= campground.title %></h1><p class="location-line large"><span>⌖</span><%= campground.province %> · <%= campground.city %> · <%= campground.location %></p></div><div class="detail-price"><% if (campground.price != null) { %><strong>¥<%= campground.price %></strong><span>/<%= tv(campground.priceUnit) %></span><% } else if (campground.sourceReferenceCost != null) { %><strong>¥<%= campground.sourceReferenceCost %></strong><span><%= t('card.referenceCost') %></span><small><%= lang === 'en' ? 'Not a booking price' : '非预订价格' %></small><% } else { %><b><%= t('card.pricePending') %></b><% } %></div></div></div></section>
<section class="container detail-content">
  <% const images = campground.images.length ? campground.images : [{ url: '/images/camp-placeholder.svg' }]; %><div class="gallery-grid images-<%= Math.min(images.length, 5) %>"><% images.slice(0, 5).forEach((image, index) => { %><img class="gallery-<%= index %>" src="<%= image.url %>" alt="<%= campground.title %>" loading="lazy" onerror="this.onerror=null;this.src='/images/camp-placeholder.svg'"><% }) %><div class="gallery-count"><%= images.length %> <%= lang === 'en' ? 'photos' : '张图片' %></div></div>
  <div class="detail-layout"><div class="detail-main">
    <section class="editorial-section"><div class="section-number">01</div><div><div class="about-heading"><h2><%= t('detail.about') %></h2><div class="trust-meter"><div><i style="width:<%= campground.reliability?.score || 0 %>%"></i></div><strong><%= lang === 'en' ? 'Trust score' : '可信度' %> <%= campground.reliability?.score || 0 %>/100</strong></div></div><p class="detail-description"><%= detailDescription %></p><div class="trust-reasons"><% (campground.reliability?.reasons || []).slice(0,4).forEach(reason => { const labels = { strong_source: lang === 'en' ? 'Strong source' : '较强数据来源', third_party_source: lang === 'en' ? 'Third-party listing' : '第三方数据', recently_updated: lang === 'en' ? 'Recently updated' : '近期更新', stale_data: lang === 'en' ? 'May be outdated' : '可能已过时', complete_profile: lang === 'en' ? 'Complete profile' : '信息较完整', missing_details: lang === 'en' ? 'Missing details' : '信息不完整', community_confirmed: lang === 'en' ? 'Community confirmed' : '社区已确认', open_community_reports: lang === 'en' ? 'Open reports' : '存在待处理报告', conflicting_evidence: lang === 'en' ? 'Conflicting evidence' : '来源存在冲突' }; %><span><%= labels[reason] || reason %></span><% }) %></div></div></section>
    <div class="fact-grid"><div><span class="fact-icon">◷</span><small><%= t('detail.opening') %></small><strong><%= lang === 'en' && campground.dataSource === 'amap' ? t('detail.callConfirm') : (campground.sourceBusinessHours || tv(campground.openSeason) || t('detail.callConfirm')) %></strong></div><div><span class="fact-icon">♙</span><small><%= t('detail.capacity') %></small><strong><%= campground.capacity ? t('card.capacity', { count: campground.capacity }) : t('detail.capacityPending') %></strong></div><div><span class="fact-icon">★</span><small><%= t('detail.rating') %></small><strong><%= average ? `${average} / 5 · ${t('detail.siteRating')}` : (campground.sourceRating ? `${campground.sourceRating} / 5 · ${t('detail.amapRating')}` : t('detail.noReviews')) %></strong></div><div><span class="fact-icon">◎</span><small><%= t('detail.source') %></small><strong><%= campground.dataSource === 'amap' ? t('detail.amapPoi') : t('detail.userPublished') %></strong></div></div>
    <section class="editorial-section amenities-section"><div class="section-number">02</div><div><h2><%= t('detail.amenities') %></h2><div class="amenity-list"><% campground.amenities.forEach(item => { %><span>✓ <%= tv(item) %></span><% }) %><% (campground.inferredAmenities || []).forEach(item => { %><span class="inferred-amenity">~ <%= tv(item.amenity) %> <small><%= lang === 'en' ? 'inferred' : '文本推断' %></small></span><% }) %><% if (!campground.amenities.length && !campground.inferredAmenities?.length) { %><p class="muted-note"><%= t('detail.amenitiesPending') %></p><% } %></div><% if (campground.inferredAmenities?.length) { %><p class="inference-note"><%= lang === 'en' ? 'Inferred amenities come from rule-based text extraction and have not been confirmed on site.' : '“文本推断”来自规则式信息抽取，尚未经过现场确认。' %></p><% } %></div></section>
    <section class="map-section"><div class="section-heading"><div><span class="section-number">03</span><h2><%= lang === 'en' ? 'Location' : '营地位置' %></h2></div><span><%= campground.district %></span></div><div class="map-shell detail-map"><div id="map"></div><% if (!amapKey) { %><div class="map-empty"><%= t('map.missing') %></div><% } %></div></section>
  </div><aside class="detail-sidebar"><div class="booking-panel"><div class="booking-top"><span class="overline dark"><%= t('detail.contact') %></span><h2><%= lang === 'en' ? 'Plan your stay' : '开始计划行程' %></h2><p><%= t('detail.bookingNotice') %></p></div><div class="contact-row"><span><%= t('detail.phone') %></span><strong><%= campground.contactPhone || t('detail.notProvided') %></strong></div><div class="contact-row"><span><%= t('detail.wechat') %></span><strong><%= campground.wechat || t('detail.notProvided') %></strong></div><% if (campground.bookingUrl) { %><a class="booking-button" href="<%= campground.bookingUrl %>" target="_blank" rel="noopener"><%= campground.dataSource === 'amap' ? t('detail.openAmap') : t('detail.book') %><span>↗</span></a><% } %><div class="booking-safety"><span>i</span><%= lang === 'en' ? 'Listing details may change. Confirm directly with the campsite.' : '营地信息可能变化，请出发前直接确认。' %></div><% if (currentUser && campground.dataSource !== 'amap' && campground.author.equals(currentUser._id)) { %><div class="owner-actions"><a href="/campgrounds/<%= campground._id %>/edit"><%= t('detail.edit') %></a><form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST"><button onclick="return confirm('<%= t('detail.deleteConfirm') %>')"><%= t('detail.delete') %></button></form></div><% } %></div></aside></div>
  <section id="community-report" class="community-evidence"><div class="reviews-heading"><div><span class="section-number">04</span><h2><%= lang === 'en' ? 'Help verify this listing' : '帮助核实这条信息' %></h2></div><span><%= fieldReports.length %> <%= lang === 'en' ? 'community reports' : '条社区报告' %></span></div><p><%= lang === 'en' ? 'A recent on-site confirmation can improve the trust score. Corrections remain visible as evidence rather than silently replacing the original source.' : '近期现场确认会提高可信度。纠错信息会作为证据保留，而不是无痕覆盖原始来源。' %></p><% if (currentUser) { %><form action="/campgrounds/<%= campground._id %>/reports" method="POST" class="report-form"><label><span><%= lang === 'en' ? 'What did you observe?' : '你观察到了什么？' %></span><select name="report[reportType]" required><option value="confirm_open"><%= lang === 'en' ? 'I confirmed it is open' : '我确认营地仍在开放' %></option><option value="closed"><%= lang === 'en' ? 'It appears closed' : '营地可能已关闭' %></option><option value="incorrect_location"><%= lang === 'en' ? 'Location is incorrect' : '位置不准确' %></option><option value="incorrect_contact"><%= lang === 'en' ? 'Contact is incorrect' : '联系方式不准确' %></option><option value="incorrect_hours"><%= lang === 'en' ? 'Hours are incorrect' : '开放时间不准确' %></option><option value="incorrect_price"><%= lang === 'en' ? 'Price is incorrect' : '价格不准确' %></option><option value="incorrect_amenity"><%= lang === 'en' ? 'Amenity information is incorrect' : '设施信息不准确' %></option><option value="safety_issue"><%= lang === 'en' ? 'Safety concern' : '安全问题' %></option><option value="other"><%= lang === 'en' ? 'Other correction' : '其他纠错' %></option></select></label><label><span><%= lang === 'en' ? 'Date observed' : '观察日期' %></span><input type="date" name="report[observedAt]" max="<%= new Date().toISOString().slice(0,10) %>" value="<%= new Date().toISOString().slice(0,10) %>" required></label><label class="wide"><span><%= lang === 'en' ? 'Correct value or note' : '正确值或补充说明' %></span><input name="report[proposedValue]" maxlength="500"></label><label class="wide"><span><%= lang === 'en' ? 'Context' : '具体情况' %></span><textarea name="report[comment]" rows="3" maxlength="1000"></textarea></label><button><%= lang === 'en' ? 'Submit evidence' : '提交证据' %> →</button></form><% } else { %><p class="login-prompt"><a href="/login"><%= t('review.loginPrefix') %></a><%= lang === 'en' ? ' to confirm or correct this listing.' : '后可以确认或纠错。' %></p><% } %><div class="evidence-list"><% evidence.slice(0,5).forEach(item => { %><article><span class="evidence-source"><%= item.sourceName %></span><strong><%= lang === 'en' ? `${item.claims.length} supported fields` : `支持 ${item.claims.length} 个字段` %></strong><time><%= new Date(item.capturedAt).toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN') %></time></article><% }) %></div></section>
  <section class="reviews-section"><div class="reviews-heading"><div><span class="section-number">05</span><h2><%= t('review.title') %></h2></div><span><%= campground.reviews.length %> <%= t('review.unit') %></span></div><% if (currentUser) { %><form action="/campgrounds/<%= campground._id %>/reviews" method="POST" class="review-form validated-form" novalidate><div><label><%= t('review.score') %></label><select name="review[rating]"><option value="5">5 — <%= lang === 'en' ? 'Excellent' : '很棒' %></option><option value="4">4 — <%= lang === 'en' ? 'Recommended' : '推荐' %></option><option value="3">3 — <%= lang === 'en' ? 'Average' : '一般' %></option><option value="2">2 — <%= lang === 'en' ? 'Poor' : '较差' %></option><option value="1">1 — <%= lang === 'en' ? 'Bad' : '很差' %></option></select></div><div class="review-text"><label><%= t('review.experience') %></label><textarea name="review[body]" rows="3" required maxlength="1000"></textarea></div><button><%= t('review.publish') %> →</button></form><% } else { %><p class="login-prompt"><a href="/login"><%= t('review.loginPrefix') %></a><%= t('review.loginSuffix') %></p><% } %><div class="review-list"><% campground.reviews.forEach(review => { %><article class="review-card-new"><div class="avatar"><%= (review.author?.username || 'U').slice(0,1).toUpperCase() %></div><div><div class="review-top"><strong><%= review.author?.username || t('review.user') %></strong><span>★★★★★</span></div><p><%= review.body %></p><small><%= review.createdAt?.toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN') %></small><% if (currentUser && review.author?._id.equals(currentUser._id)) { %><form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"><button class="delete-review"><%= t('review.delete') %></button></form><% } %></div></article><% }) %></div></section>
</section>
<script>window.campgroundData = <%- JSON.stringify({ title: campground.title, location: campground.location, geometry: campground.geometry }).replace(/</g, '\\u003c') %>;</script><script src="/javascripts/showPageMap.js"></script>
